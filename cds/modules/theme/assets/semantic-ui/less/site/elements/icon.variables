/*******************************
    Icon (fonts without SVG)
*******************************/

/* The default sources without the SVG fonts: only very old iOS Safari used
   them, and the webpack configuration of Invenio inlines every SVG in the
   CSS (about 890 KB for the three fonts). The fonts are referenced from the
   package: a relative ``@fontPath`` would resolve from this folder. */

@cdsIconFontPath: "~semantic-ui-less/themes/@{theme}/assets/fonts";

@src:
  url("@{cdsIconFontPath}/@{fontName}.eot?#iefix") format('embedded-opentype'),
  url("@{cdsIconFontPath}/@{fontName}.woff2") format('woff2'),
  url("@{cdsIconFontPath}/@{fontName}.woff") format('woff'),
  url("@{cdsIconFontPath}/@{fontName}.ttf") format('truetype')
;

@outlineSrc:
  url("@{cdsIconFontPath}/@{outlineFontName}.eot?#iefix") format('embedded-opentype'),
  url("@{cdsIconFontPath}/@{outlineFontName}.woff2") format('woff2'),
  url("@{cdsIconFontPath}/@{outlineFontName}.woff") format('woff'),
  url("@{cdsIconFontPath}/@{outlineFontName}.ttf") format('truetype')
;

@brandSrc:
  url("@{cdsIconFontPath}/@{brandFontName}.eot?#iefix") format('embedded-opentype'),
  url("@{cdsIconFontPath}/@{brandFontName}.woff2") format('woff2'),
  url("@{cdsIconFontPath}/@{brandFontName}.woff") format('woff'),
  url("@{cdsIconFontPath}/@{brandFontName}.ttf") format('truetype')
;
