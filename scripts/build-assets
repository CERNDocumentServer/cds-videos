set -e

project=$(cd "$(dirname "$0")/.." && pwd)
# Assets folder of the instance (INVENIO_INSTANCE_PATH, else <venv>/var/instance)
assets="${INVENIO_INSTANCE_PATH:-$(python -c 'import sys; print(sys.prefix)')/var/instance}/assets"

cds collect -v
cds webpack create

# The JavaScript packages come from pnpm-lock.yaml, which is made for the
# package.json generated by the installed Invenio modules
if ! cmp -s "$project/package.json" "$assets/package.json"; then
    echo "The generated package.json differs from the one of the repository:" >&2
    echo "run ./scripts/lock-assets and commit package.json and pnpm-lock.yaml" >&2
    exit 1
fi
cp "$project/pnpm-lock.yaml" "$assets/pnpm-lock.yaml"
(cd "$assets" && pnpm install --frozen-lockfile)

cds webpack build
