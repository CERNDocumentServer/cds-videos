set -e

# Update package.json and pnpm-lock.yaml after a change of the JavaScript
# dependencies of an Invenio module (installed Python packages or webpack.py)

project=$(cd "$(dirname "$0")/.." && pwd)
assets="${INVENIO_INSTANCE_PATH:-$(python -c 'import sys; print(sys.prefix)')/var/instance}/assets"

cds webpack create
# Start from the current lock file, so unchanged packages keep their versions
cp "$project/pnpm-lock.yaml" "$assets/pnpm-lock.yaml"
(cd "$assets" && pnpm install --lockfile-only)
cp "$assets/package.json" "$assets/pnpm-lock.yaml" "$project/"
